<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.telestream" name="TeleStream Repository" version="1.0.0" provider-name="TheYGN">
    <extension point="xbmc.addon.repository" name="TeleStream Repository">
        <dir>
            <info compressed="false">https://theygn.github.io/telestream-kodi/addons.xml</info>
            <checksum>https://theygn.github.io/telestream-kodi/addons.xml.md5</checksum>
            <datadir zip="true">https://theygn.github.io/telestream-kodi/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Updates for the TeleStream addon</summary>
        <summary lang="he_IL">עדכונים להרחבת טלסטרים</summary>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
<addon id="plugin.video.telestream" name="TeleStream" version="1.0.0" provider-name="TheYGN">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Movies and series from your Telegram groups</summary>
        <summary lang="he_IL">סרטים וסדרות מקבוצות הטלגרם שלך</summary>
        <description lang="en_GB">Plays videos from your own TeleStream server. This product uses the TMDB API but is not endorsed or certified by TMDB.</description>
        <description lang="he_IL">מנגן סרטונים משרת הטלסטרים שבבית. המידע והפוסטרים מגיעים מ-TMDB. This product uses the TMDB API but is not endorsed or certified by TMDB.</description>
        <platform>all</platform>
        <license>Personal use</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
